<Window x:Class="CodexTime.WinApp.TaskbarLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTime.WinApp"
        Title="CodexTime"
        Width="220"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="Surface"
            Margin="1"
            Padding="10,5"
            CornerRadius="9"
            Background="#F01D1D1F"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1"
            Cursor="Hand">
        <local:ProviderStrip x:Name="Providers" />
    </Border>
</Window>
