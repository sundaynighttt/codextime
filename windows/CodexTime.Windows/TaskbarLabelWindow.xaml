<Window x:Class="CodexTime.WinApp.TaskbarLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexTime"
        Width="196"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="Surface"
            Margin="1"
            Padding="10,5"
            CornerRadius="9"
            Background="#F01D1D1F"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1"
            Cursor="Hand">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0" Fill="#5BD696" />
            <TextBlock x:Name="UsageText"
                       Text="Codex --% · 확인 중"
                       Foreground="#F4F4F5"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
