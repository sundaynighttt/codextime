<Window x:Class="CodexTime.WinApp.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexTime"
        Width="400"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Margin="8"
            Padding="18"
            CornerRadius="16"
            Background="#FA1C1C1F"
            BorderBrush="#38FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CodexTime"
                               Foreground="#F5F5F6"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Text="Codex · Grok · Claude"
                               Margin="0,2,0,0"
                               Foreground="#9FA0A8"
                               FontSize="11.5" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Content="×"
                        Foreground="#C8C8CD"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="상세 닫기 (Esc)"
                        AutomationProperties.Name="상세 닫기"
                        FontSize="18"
                        Cursor="Hand"
                        Click="CloseButton_OnClick" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,8">
                <StackPanel x:Name="RowsPanel" />
            </ScrollViewer>
            <StackPanel x:Name="FooterPanel" Grid.Row="2" />
        </Grid>
    </Border>
</Window>
