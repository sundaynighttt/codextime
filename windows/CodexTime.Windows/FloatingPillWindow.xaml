<Window x:Class="CodexTime.WinApp.FloatingPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexTime.WinApp"
        Title="CodexTime"
        Width="220"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="Surface"
            Margin="2"
            Padding="11,6"
            CornerRadius="11"
            Background="#E81B1B1D"
            BorderBrush="#48FFFFFF"
            BorderThickness="1"
            Cursor="Hand">
        <local:ProviderStrip x:Name="Providers" />
    </Border>
</Window>
