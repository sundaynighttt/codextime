<Window x:Class="CodexTime.WinApp.FloatingPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexTime"
        Width="220"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="Surface"
            Margin="2"
            Padding="11,6"
            CornerRadius="11"
            Background="#E81B1B1D"
            BorderBrush="#48FFFFFF"
            BorderThickness="1"
            Cursor="Hand">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="#5BD696" />
            <TextBlock x:Name="UsageText"
                       Text="Codex --% · 확인 중"
                       Foreground="#F7F7F8"
                       FontFamily="Segoe UI"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
